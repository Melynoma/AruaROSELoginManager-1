<UserControl x:Class="AruaRoseLoginManager.Controls.ManagerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AruaRoseLoginManager.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="500">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="#404040">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <local:TabButton Grid.Column="0" x:Name="_accountsButton" Click="AccountsButton_Click" Style="{StaticResource ButtonStyles}" ImageSource="/Assets/accounts-icon.png" Text="_Accounts" />
            <local:TabButton Grid.Column="1" x:Name="_partiesButton" Click="PartiesButton_Click" Style="{StaticResource ButtonStyles}" ImageSource="/Assets/parties-icon.png" Text="_Parties" />
            <local:TabButton Grid.Column="2" x:Name="_optionssButton" Click="OptionsButton_Click" Style="{StaticResource ButtonStyles}" ImageSource="/Assets/settings-icon.png" Text="_Options" />
            <local:TabButton Grid.Column="3" x:Name="_patchButton" Click="PatchButton_Click" Style="{StaticResource ButtonStyles}" ImageSource="/Assets/patch-icon.png" Text="_Patch" />
            <local:TabButton Grid.Column="4" x:Name="_infoButton" Click="InfoButton_Click" Style="{StaticResource ButtonStyles}" ImageSource="/Assets/info-icon.png" Text="_Info" />
        </Grid>
        <local:AccountDisplay x:Name="_accountDisplay" Grid.Row="1" Visibility="Visible"/>
        <local:PartyDisplay x:Name="_partyDisplay" Grid.Row="1" Visibility="Hidden"/>
        <Grid Background="#404040" x:Name="_optionsDisplay" Grid.Row="1" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="25" />
                <RowDefinition Height="*" />
                <RowDefinition Height="25" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition MinWidth="5" MaxWidth="50"/>
                <ColumnDefinition Width="*" MinWidth="240"/>
                <ColumnDefinition MinWidth="5" MaxWidth="50"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" CanContentScroll="True">
                <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label Grid.Row="0" Grid.Column="0" Content="Primary Install:" FontSize="14"/>
                <TextBox Name="_folderTextBox" Grid.Row="1" Grid.Column="0" TabIndex="0" IsReadOnly="True" FontSize="14" VerticalContentAlignment="Center"/>
                <Button Grid.Row="1" Grid.Column="0" TabIndex="18" Click="BrowseFolder1Button_Click" HorizontalAlignment="Right">
                    <Image Source="/Assets/search-icon.png" Margin="5" />
                </Button>
                <Label Grid.Row="2" Grid.Column="0" Content="Default Game Resolution:" FontSize="12"/>
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Label Content="Width:" VerticalAlignment="Center" Width="50"/>
                        <TextBox Name="_defaultWidthTextBox" Text="1024" VerticalAlignment="Center" Width="60" TabIndex="3"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Label Content="Height:" VerticalAlignment="Center" Width="50"/>
                        <TextBox Name="_defaultHeightTextBox" Text="768" VerticalAlignment="Center" Width="60" TabIndex="4"/>
                    </StackPanel>
                    <CheckBox Name="_fullscreenCheckbox" Grid.Column="3" VerticalAlignment="Center" Foreground="#FFFFFF" Content="Fullscreen" TabIndex="5" Checked="FullscreenCheckbox_Checked" Unchecked="FullscreenCheckbox_Unchecked"/>
                </Grid>
                <Label Grid.Row="4" Grid.Column="0" Content="Secondary Install:" FontSize="14"/>
                <TextBox Name="_folderTextBox2" Grid.Row="5" Grid.Column="0" TabIndex="1" IsReadOnly="True" FontSize="14" VerticalContentAlignment="Center"/>
                <Button Grid.Row="5" Grid.Column="0" TabIndex="19" Click="BrowseFolder2Button_Click" HorizontalAlignment="Right">
                    <Image Source="/Assets/search-icon.png" Margin="5" />
                </Button>
                <Label Grid.Row="6" Grid.Column="0" Content="Default Game Resolution:" FontSize="12"/>
                <Grid Grid.Row="7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Label Content="Width:" VerticalAlignment="Center" Width="50"/>
                        <TextBox Name="_defaultWidthTextBox2" Text="1024" VerticalAlignment="Center" Width="60" TabIndex="6"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Label Content="Height:" VerticalAlignment="Center" Width="50"/>
                        <TextBox Name="_defaultHeightTextBox2" Text="768" VerticalAlignment="Center" Width="60" TabIndex="7"/>
                    </StackPanel>
                    <CheckBox Name="_fullscreenCheckbox2" Grid.Column="3" VerticalAlignment="Center" Foreground="#FFFFFF" Content="Fullscreen" TabIndex="8" Checked="FullscreenCheckbox2_Checked" Unchecked="FullscreenCheckbox2_Unchecked"/>
                </Grid>
                <Label Grid.Row="8" Grid.Column="0" Content="Tertiary Install:" FontSize="14"/>
                <TextBox Name="_folderTextBox3" Grid.Row="9" Grid.Column="0" TabIndex="2" IsReadOnly="True" FontSize="14" VerticalContentAlignment="Center"/>
                <Button Grid.Row="9" Grid.Column="0" TabIndex="20" Click="BrowseFolder3Button_Click" HorizontalAlignment="Right">
                    <Image Source="/Assets/search-icon.png" Margin="5" />
                </Button>
                <Label Grid.Row="10" Grid.Column="0" Content="Default Game Resolution:" FontSize="12"/>
                <Grid Grid.Row="11">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Label Content="Width:" VerticalAlignment="Center" Width="50"/>
                        <TextBox Name="_defaultWidthTextBox3" Text="1024" VerticalAlignment="Center" Width="60" TabIndex="9"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Label Content="Height:" VerticalAlignment="Center" Width="50"/>
                        <TextBox Name="_defaultHeightTextBox3" Text="768" VerticalAlignment="Center" Width="60" TabIndex="10"/>
                    </StackPanel>
                    <CheckBox Name="_fullscreenCheckbox3" Grid.Column="3" VerticalAlignment="Center" Foreground="#FFFFFF" Content="Fullscreen" TabIndex="11" Checked="FullscreenCheckbox3_Checked" Unchecked="FullscreenCheckbox3_Unchecked"/>
                </Grid>
                <StackPanel Grid.Row="12" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Label Content="Run as Admin:" FontSize="14" VerticalAlignment="Center"/>
                    <CheckBox Name="_runAsAdminCheckbox" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Row="13" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Label Content="Enable Streamer Mode:" FontSize="14" VerticalAlignment="Center"/>
                    <CheckBox Name="_streamModeCheckbox" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#FFFFFF" Content="Hide account and location data" Checked="StreamModeCheckbox_Checked" Unchecked="StreamModeCheckbox_Unchecked"/>
                </StackPanel>
                <Label Grid.Row="14" Grid.Column="0" Content="Window Size Presets:" FontSize="14"/>
                <Grid Grid.Row="15" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Name="_normalButton" Grid.Column="0" Content="Normal" Click="NormalButton_Click" Height="22" VerticalAlignment="Top"/>
                    <Button Name="_compactButton" Grid.Column="2" Content="Compact" Click="CompactButton_Click" Height="22" VerticalAlignment="Top"/>
                </Grid>
                <Button Name="_saveSettingsButton" Grid.Row="16" Grid.Column="0" Content="Save Changes" Click="SaveSettingsButton_Click" Height="30" VerticalAlignment="Top" Margin="0,0,0,8"/>
                </Grid>
            </ScrollViewer>
        </Grid>
        <Grid Background="#404040" x:Name="_patchDisplay" Grid.Row="1" Visibility="Hidden">
            <Grid.RowDefinitions>
                <RowDefinition Height="25" />
                <RowDefinition Height="*" />
                <RowDefinition Height="25" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition MinWidth="5" MaxWidth="50"/>
                <ColumnDefinition Width="*" MinWidth="240"/>
                <ColumnDefinition MinWidth="5" MaxWidth="50"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Row="1" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="Primary Install:" FontSize="14" VerticalAlignment="Center"/>
                <Button Grid.Row="0" Grid.Column="1" Content="Patch Now" Click="PatchNow1Button_Click" Height="28" Margin="8,1,0,1"/>
                <TextBlock Name="_patchFolderText1" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" FontSize="11" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>

                <Label Grid.Row="3" Grid.Column="0" Content="Secondary Install:" FontSize="14" VerticalAlignment="Center"/>
                <Button Grid.Row="3" Grid.Column="1" Content="Patch Now" Click="PatchNow2Button_Click" Height="28" Margin="8,1,0,1"/>
                <TextBlock Name="_patchFolderText2" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" FontSize="11" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>

                <Label Grid.Row="6" Grid.Column="0" Content="Tertiary Install:" FontSize="14" VerticalAlignment="Center"/>
                <Button Grid.Row="6" Grid.Column="1" Content="Patch Now" Click="PatchNow3Button_Click" Height="28" Margin="8,1,0,1"/>
                <TextBlock Name="_patchFolderText3" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" FontSize="11" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Grid>
        <Grid Background="#404040" x:Name="_infoDisplay" Grid.Row="1" Visibility="Hidden">
            <Grid.RowDefinitions>
                <RowDefinition Height="25" />
                <RowDefinition Height="*" />
                <RowDefinition Height="25" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition MinWidth="5" MaxWidth="50"/>
                <ColumnDefinition Width="*" MinWidth="240"/>
                <ColumnDefinition MinWidth="5" MaxWidth="50"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Row="1" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60" />
                    <RowDefinition Height="60" />
                    <RowDefinition Height="60" />
                    <RowDefinition Height="60" />
                    <RowDefinition Height="60" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="30" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <local:LinkButton Grid.Row="0" ImageSource="/Assets/arua-logo.png" Text="ARMORY" Link="https://armory.aruarose.com/" Colour="#2a2b2d"/>
                <local:LinkButton Grid.Row="1" ImageSource="/Assets/discord-logo.png" Text="DISCORD" Link="https://www.aruarose.com/community/discord" Colour="#7289DA"/>
                <local:LinkButton Grid.Row="2" ImageSource="/Assets/github-logo.png" Text="SOURCE" Link="https://github.com/xHergz/AruaROSELoginManager" Colour="#000000"/>
                <local:LinkButton Grid.Row="3" ImageSource="/Assets/lightbulb-icon.png" Text="SUGGESTIONS" Link="https://forum.aruarose.com/threads/aruarose-login-manager.166415/" Colour="#2e8bc0"/>
                <local:LinkButton Grid.Row="4" ImageSource="/Assets/bug-icon.png" Text="BUGS" Link="https://forum.aruarose.com/threads/aruarose-login-manager.166415/" Colour="#e43d40"/>
                <Label Grid.Row="5" Grid.Column="1" Content="Forum: @chug" HorizontalAlignment="Left" />
                <Label Grid.Row="5" Grid.Column="1" Content="Discord: Justin#1346" HorizontalAlignment="Right" />
                <Label Grid.Row="7" HorizontalAlignment="Center">v2.0.0</Label>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
