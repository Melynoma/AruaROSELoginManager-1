<UserControl x:Class="AruaRoseLoginManager.Controls.PartyDisplay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AruaRoseLoginManager.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="500">
    <Grid Background="#404040">
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*" />
            <RowDefinition Height="45" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="5" MaxWidth="50"/>
            <ColumnDefinition Width="*" MinWidth="240"/>
            <ColumnDefinition MinWidth="5" MaxWidth="50"/>
        </Grid.ColumnDefinitions>
        <Button Name="_addPartyButton" Grid.Row="0" Grid.Column="1" Width="150" HorizontalAlignment="Right" Margin="0 5 0 5" Click="NewPartyButton_Click" >
            <Label Content="_New Party" FontSize="16"/>
        </Button>
        <Grid Name="_headerGrid" Grid.Row="1" Grid.Column="1" Background="#E0E0E0" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="_headerCol1" Width="2*" />
                <ColumnDefinition x:Name="_headerCol2" Width="2*" />
                <ColumnDefinition x:Name="_headerCol3" Width="4*" />
                <ColumnDefinition x:Name="_headerCol4" Width="70" />
                <ColumnDefinition x:Name="_headerCol5" Width="70" />
                <ColumnDefinition x:Name="_headerCol6" Width="80" />
                <ColumnDefinition x:Name="_headerCol7" Width="35" />
                <ColumnDefinition x:Name="_headerCol8" Width="0" />
            </Grid.ColumnDefinitions>
            <TextBlock Name="_headerTitle1" Grid.Column="0" Text="Party Name" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,4,0"/>
            <TextBlock Name="_headerTitle2" Grid.Column="1" Text="Description" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,4,0"/>
            <TextBlock Name="_headerTitle3" Grid.Column="2" Text="Accounts" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,4,0"/>
            <TextBlock Name="_headerTitle4" Grid.Column="3" Text="Arua" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock Name="_headerTitle5" Grid.Column="4" Text="Classic" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock Name="_headerTitle6" Grid.Column="5" Text="" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock Name="_headerTitle7" Grid.Column="6" Text="Edit" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock Name="_headerTitle8" Grid.Column="7" Text="Delete" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="6" Cursor="SizeWE" Background="#66000000" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" DragCompleted="HeaderColumnSplitter_DragCompleted"/>
            <GridSplitter Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="6" Cursor="SizeWE" Background="#66000000" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" DragCompleted="HeaderColumnSplitter_DragCompleted"/>
            <GridSplitter Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="6" Cursor="SizeWE" Background="#66000000" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" DragCompleted="HeaderColumnSplitter_DragCompleted"/>
            <GridSplitter Grid.Column="4" HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="6" Cursor="SizeWE" Background="#66000000" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" DragCompleted="HeaderColumnSplitter_DragCompleted"/>
            <GridSplitter Grid.Column="5" HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="6" Cursor="SizeWE" Background="#66000000" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" DragCompleted="HeaderColumnSplitter_DragCompleted"/>
            <GridSplitter Grid.Column="6" HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="6" Cursor="SizeWE" Background="#66000000" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" DragCompleted="HeaderColumnSplitter_DragCompleted"/>
            <GridSplitter Grid.Column="7" HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="6" Cursor="SizeWE" Background="#66000000" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" DragCompleted="HeaderColumnSplitter_DragCompleted"/>
        </Grid>
        <ScrollViewer Name="_partyDisplayScrollViewer" Grid.Row="2" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Name="_partyStackPanel" Grid.Row="1" Grid.Column="1" >

            </StackPanel>
        </ScrollViewer>
        <local:PartyForm x:Name="_partyForm" Grid.Row="2" Grid.Column="1" Visibility="Hidden" Cancel="PartyForm_Cancel" SaveParty="PartyForm_SaveParty" DeleteParty="PartyForm_DeleteParty">

        </local:PartyForm>
    </Grid>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
</UserControl>
