<Window x:Class="AruaRoseLoginManager.Controls.WebsitePasswordPrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AruaGuard Login" Height="240" Width="420" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#303030">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Foreground="White" FontSize="13" Text="Enter website password to autofill Arua login."/>
        <TextBlock Grid.Row="1" Margin="0,12,0,4" Foreground="White" Text="Username"/>
        <TextBox Grid.Row="2" Name="_usernameTextBox" IsReadOnly="True" Height="28" VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="3" Margin="0,10,0,4" Foreground="White" Text="Website Password"/>
        <PasswordBox Grid.Row="4" Name="_passwordBox" Height="28" VerticalContentAlignment="Center"/>

        <Grid Grid.Row="6" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Cancel" IsCancel="True" Click="CancelButton_Click" Height="30"/>
            <Button Grid.Column="2" Content="Continue" IsDefault="True" Click="ContinueButton_Click" Height="30"/>
        </Grid>
    </Grid>
</Window>