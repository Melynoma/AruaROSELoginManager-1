<UserControl x:Class="AruaRoseLoginManager.Controls.ListDisplay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AruaRoseLoginManager.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="44" d:DesignWidth="1000">
    <Grid Name="_listDisplayGrid" Background="#EAEAEA" SizeChanged="ListDisplayGrid_SizeChanged" AllowDrop="True" PreviewMouseLeftButtonDown="ListDisplayGrid_PreviewMouseLeftButtonDown" PreviewMouseMove="ListDisplayGrid_PreviewMouseMove" DragOver="ListDisplayGrid_DragOver" Drop="ListDisplayGrid_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="_col1" Width="2*" />
            <ColumnDefinition x:Name="_col2" Width="2*" />
            <ColumnDefinition x:Name="_col3" Width="4*" />
            <ColumnDefinition x:Name="_col4" Width="70" />
            <ColumnDefinition x:Name="_col5" Width="70" />
            <ColumnDefinition x:Name="_col6" Width="80" />
            <ColumnDefinition x:Name="_col7" Width="35" />
            <ColumnDefinition x:Name="_col8" Width="35" />
            <ColumnDefinition Width="0" />
        </Grid.ColumnDefinitions>
        <Image Name="_emblem" Grid.Row="0" Grid.Column="0" Width="1" Height="1" Visibility="Collapsed" Source="../Emblems/emblem1.png"/>
        <TextBlock Name="_listItemIdentifier" Grid.Row="0" Grid.Column="0" Text="List Item Identifier" FontSize="14" FontWeight="Bold" Foreground="#222" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0,4,0"/>
        <Grid Grid.Row="0" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
            </Grid.ColumnDefinitions>
            <TextBlock Name="_listItemDescription" Grid.Column="0" Text="Alias" TextTrimming="CharacterEllipsis" FontSize="13" Foreground="#222" VerticalAlignment="Center" Margin="8,0,4,0"/>
            <Image Name="_allInfoIncluded" Grid.Column="1" Width="16" Height="16" Source="../Assets/check-icon.png" VerticalAlignment="Center"/>
        </Grid>
        <TextBlock Name="_listItemDetails" Grid.Row="0" Grid.Column="2" Text="Characters" TextTrimming="CharacterEllipsis" FontSize="13" Foreground="#222" VerticalAlignment="Center" Margin="8,0,4,0"/>
        <Button Name="_aruaLoginButton" Grid.Row="0" Grid.Column="3" Width="65" Height="25" Content="Arua" FontWeight="Normal" Click="AruaLoginButton_Click" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <Button Name="_classicLoginButton" Grid.Row="0" Grid.Column="4" Width="65" Height="25" Content="Classic" FontWeight="Normal" Click="ClassicLoginButton_Click" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <Button Name="_aruaGuardButton" Grid.Row="0" Grid.Column="5" Width="74" Height="25" Content="AruaGuard" Click="AruaGuardButton_Click" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11" FontWeight="Normal"/>
        <Button Name="_editButton" Grid.Row="0" Grid.Column="6" Width="25" Height="25" Click="EditButton_Click" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Image Source="../Assets/edit-icon.png" Margin="2" />
        </Button>
        <Button Name="_deleteButton" Grid.Row="0" Grid.Column="7" Width="25" Height="25" Click="DeleteButton_Click" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Image Source="../Assets/delete-icon.png" Margin="2" />
        </Button>
        <Button Name="_moveUpButton" Grid.Row="0" Grid.Column="8" Width="1" Height="1" Visibility="Collapsed" Click="MoveUpButton_Click"/>
        <Button Name="_moveDownButton" Grid.Row="0" Grid.Column="9" Width="1" Height="1" Visibility="Collapsed" Click="MoveDownButton_Click"/>
    </Grid>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
</UserControl>
