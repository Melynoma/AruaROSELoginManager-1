<UserControl x:Class="AruaRoseLoginManager.Controls.PartyForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AruaRoseLoginManager.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="525" d:DesignWidth="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="25" />
            <RowDefinition Height="25" />
            <RowDefinition Height="25" />
            <RowDefinition Height="25" />
            <RowDefinition Height="25" />
            <RowDefinition Height="25" />
            <RowDefinition Height="25" />
            <RowDefinition Height="25" />
            <RowDefinition Height="25" />
            <RowDefinition Height="25" />
            <RowDefinition Height="25" />
            <RowDefinition Height="25" />
            <RowDefinition Height="25" />
            <RowDefinition Height="25" />
            <RowDefinition Height="25" />
            <RowDefinition Height="25" />
            <RowDefinition Height="15" />
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="25"/>
        </Grid.ColumnDefinitions>
        <Label Grid.Row="0" Content="Party Name*" Grid.ColumnSpan="2" />
        <Label Name="_partyNameError" Grid.Row="0" Content="Party Name is required" HorizontalContentAlignment="Right" Foreground="Red" Visibility="Hidden" TextInput="_partyNameError_TextInput" Grid.ColumnSpan="2"/>
        <TextBox Name="_partyNameTextBox" Grid.Row="1" TabIndex="0" Grid.ColumnSpan="2"/>
        <Label Grid.Row="2" Content="Description" Grid.ColumnSpan="2" />
        <TextBox Name="_descriptionTextBox" Grid.Row="3" TabIndex="2" Grid.ColumnSpan="2" />
        <Label Grid.Row="4" Content="Select Accounts" Grid.ColumnSpan="2" />
        <ComboBox Name="_accountComboBox" Grid.Row="5" TabIndex="3" Grid.ColumnSpan="1" />
        <Button Name="_addAccountButton" Grid.Row="5"  Grid.Column="1" TabIndex="4" Click="AddAccountButton_Click">
            <Image Source="/Assets/add-icon.png" />
        </Button>
        <Label Grid.Row="6" Content="Party Members" Grid.ColumnSpan="2" />
        <Label Name="_partyMembersError" Grid.Row="6" Content="At least one party member is required" HorizontalContentAlignment="Right" Foreground="Red" Visibility="Hidden" Grid.ColumnSpan="2"/>
        <Grid Grid.Row="7" Grid.RowSpan="9" Grid.ColumnSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Name="_partyMembersHeader" Grid.Row="0" Margin="0,0,0,2" Background="#EEE">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" MaxWidth="250"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="55"/>
                    <ColumnDefinition Width="55"/>
                    <ColumnDefinition Width="45"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="30"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Member" FontWeight="Bold" Foreground="Black" Padding="2,0"/>
                <Label Grid.Column="1" Content="Location" FontWeight="Bold" Foreground="Black" Padding="2,0"/>
                <Label Grid.Column="2" Content="Width" FontWeight="Bold" Foreground="Black" Padding="2,0"/>
                <Label Grid.Column="4" Content="Height" FontWeight="Bold" Foreground="Black" Padding="2,0"/>
                <Label Grid.Column="5" Content="Fullscreen" FontWeight="Bold" Foreground="Black" Padding="2,0"/>
                <Label Grid.Column="6" Content="X" FontWeight="Bold" Foreground="Black" Padding="2,0"/>
                <Label Grid.Column="7" Content="Y" FontWeight="Bold" Foreground="Black" Padding="2,0"/>
                <Label Grid.Column="8" Content="Set" FontWeight="Bold" Foreground="Black" Padding="2,0"/>
                <Label Grid.Column="9" Content="Monitor" FontWeight="Bold" Foreground="Black" Padding="2,0"/>
            </Grid>

            <Grid Grid.Row="1">
                <Label Name="_noneLabel" Content="None" FontStyle="Italic"/>
                <ScrollViewer Name="_partyListScrollViewer" VerticalScrollBarVisibility="Auto">
                    <StackPanel Name="_partyListStackPanel">

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
        <Grid Grid.Row="17" Grid.ColumnSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Name="_cancelButton" Grid.Column="1" Content="Cancel" TabIndex="9" IsCancel="True" Click="CancelButton_Click" MinWidth="90" Padding="12,6" Margin="0,0,8,0" />
            <Button Name="_deletePartyButton" Grid.Column="2" Content="Delete" TabIndex="10" Click="DeletePartyButton_Click" Visibility="Collapsed" MinWidth="90" Padding="12,6" Margin="0,0,8,0" />
            <Button Name="_savePartyButton" Grid.Column="3" Content="Save" TabIndex="8" IsDefault="True" Click="SavePartyButton_Click" MinWidth="90" Padding="12,6" />
        </Grid>

    </Grid>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
</UserControl>
